# Copy to .env.local for local development. Only public values belong here:
# everything prefixed VITE_ is bundled into the browser.
VITE_API_BASE_URL=http://localhost:5000/api
VITE_GOOGLE_MAPS_KEY=
# Optional error monitoring (Sentry browser DSN). Leave empty to turn it off.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
